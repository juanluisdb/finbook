{
  "name": "finbook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "lint": "oxlint --type-aware --ignore-path .oxlintignore .",
    "format:check": "oxfmt --check --ignore-path .oxfmtignore .",
    "test": "vitest run",
    "check": "tsc -b && oxlint --type-aware --ignore-path .oxlintignore . && oxfmt --check --ignore-path .oxfmtignore . && vitest run"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.80.0",
    "@types/node": "24.13.3",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": "^24.19.0"
  },
  "packageManager": "pnpm@11.24.0"
}
